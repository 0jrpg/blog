# -----------------------------------------------------------------------------
# Copie este arquivo para .env.local (dev) e cadastre os mesmos nomes/valores
# em Vercel → Project → Settings → Environment Variables (produção).
# Nenhuma dessas variáveis é exposta ao navegador — todas são lidas só no
# servidor (rotas de API / NextAuth).
# -----------------------------------------------------------------------------

# Repositório onde os posts (criptografados) são gravados.
GITHUB_REPO_OWNER=seu-usuario
GITHUB_REPO_NAME=liquid-blog
GITHUB_REPO_BRANCH=main

# Token do "bot" do blog — o ÚNICO token que fala com a API do GitHub.
# Crie em: https://github.com/settings/personal-access-tokens/new
#   - Repository access: Only select repositories → escolha só este repositório
#   - Permissions:
#       Contents        → Read and write
#       Administration  → Read-only   (necessário para checar quem é colaborador)
# Defina uma validade e guarde o valor gerado (começa com "github_pat_...").
GITHUB_BOT_TOKEN=github_pat_xxxxxxxx

# Chave simétrica usada para criptografar/descriptografar o conteúdo dos
# posts antes de gravar no GitHub. Gere uma nova com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde em local seguro: se você perder essa chave, os posts já
# gravados no GitHub ficam ilegíveis para sempre.
POSTS_ENCRYPTION_KEY=

# OAuth App do GitHub, usado para o login de admin/colaborador.
# Crie em: https://github.com/settings/developers → "New OAuth App"
#   - Homepage URL: a URL do seu site na Vercel
#   - Authorization callback URL: <sua-url>/api/auth/callback/github
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Segredo do NextAuth (assina sessão/JWT). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# Necessário em produção fora da Vercel, ou se você fixar um domínio próprio.
# Na Vercel normalmente não precisa definir (ela detecta sozinha), mas não
# custa deixar explícito com a URL final do site.
NEXTAUTH_URL=https://seu-blog.vercel.app
